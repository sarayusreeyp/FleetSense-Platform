# ==============================================================================
# FleetSense Environment Variables - Template Example (.env.example)
# Copy this file to .env and configure for your local or cloud setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Active Environment Toggle
# Choose: 'development' or 'production'
# ------------------------------------------------------------------------------
ENVIRONMENT=development
FLEETSENSE_APP_ENV=development
FLEETSENSE_CONFIG_PATH=configs/config.yaml
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Storage Backend Configuration
# Set to 'local' for local development or 'azure' for cloud/production
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_DATA_DIR=data

# Azure Blob Storage (Required when STORAGE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=fleetsense-production
AZURE_CONTAINER_NAME=fleetsense-production

# ------------------------------------------------------------------------------
# 3. Model Serving & API
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_TIMEOUT=30
API_RETRY_ATTEMPTS=3
FLEETSENSE_MODEL_ARTIFACT_PATH=artifacts/models/latest_model.joblib

# ------------------------------------------------------------------------------
# 4. MLflow Experiment Tracking & Model Registry
# Local Dev:  sqlite:///mlflow.db
# Production: postgresql://mlflow:mlflow@localhost:5432/mlflow or http://mlflow:5000
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=fleetsense-trip-duration
ALLOW_SQLITE_TRACKING=true

# ------------------------------------------------------------------------------
# 5. Prefect Orchestration
# ------------------------------------------------------------------------------
# PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_WORK_POOL_NAME=fleetsense-pool

# ------------------------------------------------------------------------------
# 6. Monitoring & Security
# ------------------------------------------------------------------------------
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_PORT=8000
FLEETSENSE_METRICS_API_KEY=
PROMETHEUS_URL=http://fleetsense-prometheus:9090
