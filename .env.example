# ==============================================================================
# FleetSense Environment Variables - Template Example (.env.example)
# ==============================================================================

ENVIRONMENT=development
FLEETSENSE_CONFIG_PATH=configs/config.yaml

LOG_LEVEL=DEBUG

# Storage
STORAGE_BACKEND=local
LOCAL_DATA_DIR=data

# Azure Blob Storage (Optional in dev)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=fleetsense-dev

# API Serving
API_HOST=127.0.0.1
API_PORT=8000
API_TIMEOUT=30
API_RETRY_ATTEMPTS=3

# Prefect
# PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_WORK_POOL_NAME=fleetsense-pool

# MLflow
MLFLOW_TRACKING_URI=postgresql://mlflow:mlflow@localhost:5432/mlflow
MLFLOW_EXPERIMENT_NAME=fleetsense-trip-duration

# Monitoring & Security
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_PORT=8000
PROMETHEUS_MULTIPROC_DIR=
METRICS_API_KEY=
