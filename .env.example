# ==============================================================================
# FleetSense Environment Variables - Template (.env.example)
# Copy this to .env (or .env.development / .env.production)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
FLEETSENSE_CONFIG_PATH=configs/config.yaml

# Logging
LOG_LEVEL=INFO

# Storage Configuration
# Supported: "local" or "azure"
STORAGE_BACKEND=local
LOCAL_DATA_DIR=data

# Azure Blob Storage (Required when STORAGE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=fleetsense-data

# API Serving
API_HOST=0.0.0.0
API_PORT=8000
API_TIMEOUT=30
API_RETRY_ATTEMPTS=3

# Prefect Orchestration
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_WORK_POOL_NAME=fleetsense-pool

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=fleetsense-trip-duration

# Monitoring & Prometheus
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_PORT=8000
